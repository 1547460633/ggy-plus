<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ggy.iot.mapper.IotDeviceMapper">
    <select id="selectByIdForUpdate" resultType="org.ggy.iot.domain.IotDevice">
        SELECT * FROM iot_device WHERE device_id = #{deviceId} AND del_flag = '0' FOR UPDATE
    </select>
</mapper>
